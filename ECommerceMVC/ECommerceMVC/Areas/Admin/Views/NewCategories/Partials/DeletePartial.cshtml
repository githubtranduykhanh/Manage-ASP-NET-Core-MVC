@model ECommerceMVC.UI.Areas.Admin.ViewModels.NewCategories.NewCategoryVM



<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">New Category /</span> Confirmed Delete</h4>
    <div class="card">
        <div class="alert alert-danger" role="alert">
            Do you want to delete the product<br />
            ID : @Model.Id <br />
            Name : @Model.Name <br />
            Display Order : @Model.DisplayOrder <br /> 
            @if (string.IsNullOrEmpty(Model.NewParentName))
            {
                @:New Parent Name : @Model.NewParentName <br />
            }
         </div>
        <form id="js-form-partial" asp-action="Delete" asp-route-id="@Model.Id">
            <div class="form-group">
                <button type="submit" data-id="@Model.Id" class="btn btn-danger">
                    Delete
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </form>  
    </div>
</div>
@model ECommerceMVC.UI.Areas.Admin.ViewModels.NewCategories.NewCategoryVM


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">New Category /</span> Detail</h4>

    <div class="card">         
            <h5 class="card-header">Profile Details</h5>
            <!-- Account -->
            <div class="card-body">
                <div class="card-datatable table-responsive">
                    <table class="table">
                        <tbody>
                            <tr data-dt-row="40" data-dt-column="2">
                                <td>New Category:</td>
                                <td>
                                    <div class="d-flex justify-content-start align-items-center product-name">
                                        <div class="avatar-wrapper">
                                            <div class="avatar avatar me-4 rounded-2 bg-label-secondary">
                                                <img src="@Model.UrlImage" alt="Product-9" class="rounded" style="object-fit: cover;" />
                                            </div>
                                        </div>
                                        <div class="d-flex flex-column">
                                            <h6 class="text-nowrap mb-0">@Model.Name</h6>
                                            @if (Model != null && !string.IsNullOrEmpty(Model.NewParentName))
                                            {
                                                <small class="text-truncate d-none d-sm-block">
                                                    New Parent Name : @Model.NewParentName
                                                </small>
                                            }                                        
                                        </div>
                                    </div>
                                </td>
                            </tr>
                          
                                              
                            
                            
                          
                            <tr data-dt-row="40" data-dt-column="5">
                                <td>Display Order:</td>
                                <td>
                                    <span class="text-truncate d-flex align-items-center text-heading">
                                        <span class="w-px-30 h-px-30 badge badge-center rounded-pill bg-primary bg-primary me-4 p-3">
                                            @Model.DisplayOrder
                                        </span>                                                                       
                                    </span>
                                </td>
                            </tr>                         
                        </tbody>
                    </table>
                </div>
                <!-- Add other properties here -->
                <div class="form-group mt-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>       
    </div>
</div>



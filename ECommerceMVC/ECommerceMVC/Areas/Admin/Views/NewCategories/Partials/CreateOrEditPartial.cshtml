@model ECommerceMVC.UI.Areas.Admin.ViewModels.NewCategories.NewCategoryVM

@{
    ViewData["Title"] = "New Category Create";
    var statusMessage = TempData["StatusMessage"] as string;
    var urlImage = Model != null && Model.UrlImage != null ? Model.UrlImage : "https://i.pinimg.com/originals/f1/0f/f7/f10ff70a7155e5ab666bcdd1b45b726d.jpg";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card">
        <partial name="_StatusMessagePartial" model="statusMessage" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <form asp-action="@ViewBag.Type" enctype="multipart/form-data" id="js-form-partial">
            <h5 class="card-header">Profile Details</h5>
            <!-- Account -->
            <div class="card-body">
                <input asp-for="Id" hidden />
                <div class="d-flex align-items-start align-items-sm-center gap-4">
                    <img src="@urlImage"
                         alt="user-avatar"
                         class="d-block rounded"
                         height="100"
                         width="100"
                         id="uploadedAvatar" />
                    <div class="button-wrapper">
                        <label for="upload" class="btn btn-primary me-2 mb-4" tabindex="0">
                            <span class="d-none d-sm-block">Upload new photo</span>
                            <i class="bx bx-upload d-block d-sm-none"></i>
                            <input type="file"
                                   id="upload"
                                   asp-for="Image"
                                   class="account-file-input"
                                   hidden
                                   accept="image/png, image/jpeg" />
                        </label>
                        <button type="button" class="btn btn-outline-secondary account-image-reset mb-4">
                            <i class="bx bx-reset d-block d-sm-none"></i>
                            <span class="d-none d-sm-block">Reset</span>
                        </button>

                        <p class="text-muted mb-0">Allowed JPG, GIF or PNG. Max size of 800K</p>
                    </div>
                </div>
            </div>
            <hr class="my-0" />
            <div class="card-body">
                <div class="form-floating mb-3">
                    @Html.DropDownListFor(model => model.IdNewParent, (SelectList)ViewBag.CategoryList, new { @class = "form-control" })
                    <label asp-for="IdNewParent">New Category</label>
                    <span asp-validation-for="IdNewParent" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Name" class="form-control" autocomplete="Name" aria-required="true" placeholder="TranDuyKhanh001" />
                    <label asp-for="Name"></label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="DisplayOrder" class="form-control" autocomplete="DisplayOrder" aria-required="true" placeholder="0" />
                    <label asp-for="DisplayOrder"></label>
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                </div>
                <!-- Add other properties here -->
                <div class="form-group">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>




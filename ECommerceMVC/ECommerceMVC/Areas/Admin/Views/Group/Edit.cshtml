@model ECommerceMVC.Domain.Entities.DbGroup

@{
    ViewData["Title"] = "Group Edit";
    var statusMessage = TempData["StatusMessage"] as string;
}


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">Group /</span> Edit</h4>

    <div class="card">
        <partial name="_StatusMessagePartial" model="statusMessage" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <form asp-action="Edit" enctype="multipart/form-data">
            <h5 class="card-header">Profile Details</h5>
            <input asp-for="Id" hidden />
            <!-- Account -->
            <div class="card-body">
                <div class="d-flex align-items-start align-items-sm-center gap-4">
                    <img src="@Model.Image"
                         alt="user-avatar"
                         class="d-block rounded"
                         height="100"
                         width="100"
                         style="object-fit:cover"
                         id="uploadedAvatar" />
                    <div class="button-wrapper">
                        <label for="upload" class="btn btn-primary me-2 mb-4" tabindex="0">
                            <span class="d-none d-sm-block">Upload new photo</span>
                            <i class="bx bx-upload d-block d-sm-none"></i>
                            <input type="file"
                                   asp-for="Image"
                                   id="upload"
                                   class="account-file-input"
                                   hidden
                                   accept="image/png, image/jpeg" />
                        </label>
                        <span asp-validation-for="Image" class="text-danger"></span>
                        <button type="button" class="btn btn-outline-secondary account-image-reset mb-4">
                            <i class="bx bx-reset d-block d-sm-none"></i>
                            <span class="d-none d-sm-block">Reset</span>
                        </button>

                        <p class="text-muted mb-0">Allowed JPG, GIF or PNG. Max size of 800K</p>
                    </div>
                </div>
            </div>
            <hr class="my-0" />
            <div class="form-floating mb-3">
                @Html.DropDownListFor(model => model.IdGroupParent, (SelectList)ViewBag.ParenstList, new { @class = "form-control" })
                <label asp-for="IdGroupParent">User Name Or Email</label>
                <span asp-validation-for="IdGroupParent" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" autocomplete="Name" aria-required="true" placeholder="TranDuyKhanh001" />
                <label asp-for="Name"></label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="DisplayOrder" class="form-control" autocomplete="DisplayOrder" aria-required="true" placeholder="DisplayOrder" />
                <label asp-for="DisplayOrder"></label>
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
            <!-- Add other properties here -->
            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>

        </form>

    </div>
</div>




@section scriptsAdminPage {
    @{
        await Html.RenderPartialAsync("_TableScriptsPartial");
    }
}



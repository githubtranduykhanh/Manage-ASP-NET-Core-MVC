@using ECommerceMVC.Application.Dtos.Order
@model ECommerceMVC.Application.Dtos.ResponseService<OrderStatistical>


@{
    ViewData["Title"] = "Index";
    var model = Model;
    var HelperToastsScriptPath = Url.Content("~/js/helper/HelperToasts.js");
    var HelperLoadingScriptPath = Url.Content("~/js/helper/HelperLoading.js");
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">Order /</span> List</h4>
    <div class="card mb-4">
        <div class="card-widget-separator-wrapper">
            <div class="card-body card-widget-separator">
                <div class="row gy-4 gy-sm-1">
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0">@(Model?.data?.Pending ?? 0)</h4>
                                <p class="mb-0">Pending</p>
                            </div>
                            <span class="avatar w-px-40 h-px-40 me-sm-4">
                                <span class="avatar-initial bg-label-secondary rounded">
                                    <i class="bx bx-calendar icon-calendar bx-lg text-heading"></i>
                                </span>
                            </span>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none me-6">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0">@(Model?.data?.Completed ?? 0)</h4>
                                <p class="mb-0">Completed</p>
                            </div>
                            <span class="avatar w-px-40 h-px-40 p-2 me-lg-4">
                                <span class="avatar-initial bg-label-secondary rounded">
                                    <i class="bx bx-check-double icon-calendar bx-lg text-heading"></i>
                                </span>
                            </span>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none">
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start border-end pb-4 pb-sm-0 card-widget-3">
                            <div>
                                <h4 class="mb-0">@(Model?.data?.Processing ?? 0)</h4>
                                <p class="mb-0">Processing</p>
                            </div>
                            <span class="avatar w-px-40 h-px-40 p-2 me-sm-4">
                                <span class="avatar-initial bg-label-secondary rounded">
                                    <i class="bx bx-wallet icon-calendar bx-lg text-heading"></i>
                                </span>
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="mb-0">@(Model?.data?.Cancelled ?? 0)</h4>
                                <p class="mb-0">Cancelled</p>
                            </div>
                            <span class="avatar w-px-40 h-px-40 p-2">
                                <span class="avatar-initial bg-label-secondary rounded">
                                    <i class="bx bx-error-alt icon-calendar bx-lg text-heading"></i>
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive text-nowrap p-4 pt-0">
            <table class="table table-striped" id="js-table-data">
                <thead>
                    <tr>
                        <th></th>
                        <th>Order</th>
                        <th>CreatedAt</th>
                        <th>Payment Type</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                </tbody>
            </table>
        </div>
    </div>
</div>


@section cssAdminPage {
    @{
        await Html.RenderPartialAsync("_TableBasePageCssPartial");
    }
}


@section scriptsAdminPage {
    @{
        var controller = "Orders";
        await Html.RenderPartialAsync("_TableScriptsPartial");
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/common/datatable.js"></script>
    <script src="~/js/helper/helpermodal.js"></script>
    <script type="module">
        import { ToastBody } from "@HelperToastsScriptPath"
        import Loading from "@HelperLoadingScriptPath"
        import NProgress from 'https://cdn.jsdelivr.net/npm/nprogress@0.2.0/+esm'
        $(document).ready(function () {

            var Table


            // Customizing and creating a Spinner
            const loading = new Loading({
                lines: 13, // The number of lines to draw
                length: 38, // The length of each line
                width: 17, // The line thickness
                radius: 45, // The radius of the inner circle
                scale: 0.65, // Scales overall size of the spinner
                corners: 1, // Corner roundness (0..1)
                speed: 1, // Rounds per second
                rotate: 0, // The rotation offset
                animation: 'spinner-line-fade-quick', // The CSS animation name for the lines
                direction: 1, // 1: clockwise, -1: counterclockwise
                color: '#5f61e6', // CSS color or array of colors
                fadeColor: 'white', // CSS color or array of colors
                top: '50%', // Top position relative to parent
                left: '50%', // Left position relative to parent
                shadow: '0 0 1px transparent', // Box-shadow for the lines
                zIndex: 2000000000, // The z-index (defaults to 2e9)
                className: 'spinner', // The CSS class to assign to the spinner
                position: 'absolute', // Element positioning
            })


            const toast = new ToastBody({ placement: 'top-0 end-0', title: 'E Commerce', icon: '<i class="bx bx-bell me-2"></i>', toastOptions: { delay: 2000, autohide: true } })
            // Create Modal
            const modalManager = new Modal();
            const { modalElement, bodyElement, titleElement } = modalManager.createModal({ id: 'main-modal', title: 'Modal title' });

            const modal = new bootstrap.Modal(modalElement);



            const options = {
                controller: 'Orders',
                tableName: 'Orders',
                titleModalCreate: 'Create Order',
                titleModalEdit: 'Edit Order',
                titleModalConfirmedDelete: 'Confirmed Delete Order',
                titleModalDelete: 'Delete Order',
                titleModalDetails: 'Details Order',
            }


            function AddEvenBtn() {
                // Sự kiện click cho các nút trong bảng
                $(document).on('click', '.js-edit-btn', function () {
                    const url = $(this).data('url');
                    Edit(url);
                });

                $(document).on('click', '.js-delete-confirmed-btn', function () {
                    const url = $(this).data('url');
                    DeleteConfirmed(url);
                });

                $(document).on('click', '.js-detail-btn', function (event) {
                    event.preventDefault();
                    const url = $(this).attr('href');
                    Detail(url);
                });
            }


            Table = renderTable({
                tableID: "#js-table-data",
                columns: [
                    {
                        "data": null,
                        "render": function (data, type, row) {
                            const detailUrl = '@Url.Action("DetailsPartial", controller)/' + row.id;
                            return '<a class="js-detail-btn" href="' + detailUrl + '"><i class="bx bxs-plus-circle"></i></a>';
                        },
                        "orderable": false
                    },
                    {
                        "data": null,
                        render: function (data, type, row) {
                            return `<div class="d-flex justify-content-start align-items-center order-name text-nowrap">                                       
                                        <div class="d-flex flex-column">
                                            <h6 class="m-0">
                                                <a href="pages-profile-user.html" class="text-heading">${row.nameUser}</a>
                                            </h6>
                                            <small>${row.emailUser}</small>
                                            <small>${row.phoneUser}</small>
                                        </div>
                                    </div>
                                    `
                        },
                        "orderable": false
                    },
                    {
                        "data": "createdAt",
                        render: function (data, type, row) {
                            let formattedDate = new Date(data).toLocaleDateString('vi-VN');
                            return `<span class="text-nowrap">${formattedDate}</span>`
                        },
                    },
                    {
                        "data": "paymentType",
                        render: function (data, type, row) {
                            return `<h6 class="mb-0 align-items-center d-flex w-px-100 text-warning"><i class="bx bxs-circle bx-8px me-1"></i>${data}</h6>`
                        },
                    },
                    {
                        "data": "status",
                        render: function (data, type, row) {
                            return `<span class="badge px-2 bg-label-success" text-capitalized="">${data}</span>`
                        },
                    },
                    {
                        "data": null,
                        "render": function (data, type, row) {
                            const editUrl = '@Url.Action("CreateOrEditPartial", controller)/' + row.id;
                            const deleteUrl = '@Url.Action("Delete", controller)/' + row.id;
                            return `<div class="dropdown">
                                            <button type="button" class="p-0 btn btn-primary btn-icon rounded-pill dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                                 <i class="bx bx-dots-vertical-rounded"></i>
                                                                            </button>
                                                                            <div class="dropdown-menu">
                                                                                <button class="dropdown-item js-edit-btn" type="button" data-url="${editUrl}">
                                                                                    <i class="bx bx-edit-alt me-1"></i> Edit
                                                                                </button>
                                                                                <button class="dropdown-item js-delete-confirmed-btn" type="button" data-url="${deleteUrl}"><i class="bx bx-trash me-1"></i> Delete</button>
                                                                            </div>
                                                                        </div>`;



                        },
                        "orderable": false
                    }
                ],
                url: "@Url.Action("GetAllDataTable", controller)",
                tableName: options.tableName,
                FnCreate: Create,
                initComplete: AddEvenBtn
            });

            Table.on('processing.dt', async function (e, settings, processing) {
                if (processing) {
                    $('.dataTables_processing').show();  // Hiển thị processing khi bắt đầu xử lý
                  
                    console.log('show')
                } else {
                    $('.dataTables_processing').hide();  // Ẩn processing khi hoàn tất
                    console.log('hide')
                   
                }
            });


            function Create(e, dt, node, config) {
                $.get("@Url.Action("CreateOrEditPartial", controller)")
                    .done(function (res) {
                        modalManager.updateTitle(modalElement, options.titleModalCreate)
                        modalManager.addContentToBody(modalElement, res)
                        modal.show()
                        handleDisplayImageUpload()
                        initTableOrderDetail()
                        initializeForm()
                    })
            }


            function Edit(url) {
                $.get(url)
                    .done(function (res) {
                        modalManager.updateTitle(modalElement, options.titleModalEdit)
                        modalManager.addContentToBody(modalElement, res)
                        modal.show()
                        handleDisplayImageUpload()
                        initTableOrderDetail()
                        initializeForm()
                    })
            }

            function DeleteConfirmed(url) {
                $.get(url)
                    .done(function (res) {
                        modalManager.updateTitle(modalElement, options.titleModalConfirmedDelete)
                        modalManager.addContentToBody(modalElement, res)
                        modal.show()
                        initializeForm()
                    })
            }


            function Detail(url) {
                $.get(url)
                    .done(function (res) {
                        modalManager.updateTitle(modalElement, options.titleModalDetails)
                        modalManager.addContentToBody(modalElement, res)
                        modal.show()
                    })
            }



            function initTableOrderDetail(){
                renderTableNoAjax({
                    tableID: '#js-table-order-detail',
                    tableName: 'Order Details'
                });
            }


            function handleDisplayImageUpload() {
                // Update/reset user image of account page
                let accountUserImage = document.getElementById('uploadedAvatar');
                const fileInput = document.querySelector('.account-file-input');
                const resetFileInput = document.querySelector('.account-image-reset');

                if (accountUserImage) {
                    const resetImage = accountUserImage.src;
                    fileInput.onchange = () => {
                        if (fileInput.files[0]) {
                            accountUserImage.src = window.URL.createObjectURL(fileInput.files[0]);
                        }
                    };
                    resetFileInput.onclick = () => {
                        fileInput.value = '';
                        accountUserImage.src = resetImage;
                    };
                }
            }

            // Function to initialize form
            function initializeForm() {
                // Example: Bind a submit event handler to the form
                $('#js-form-partial').on('submit', function (event) {
                    event.preventDefault();
                    // Your form handling logic here
                    console.log('Form submitted');

                    $.validator.unobtrusive.parse(this)

                    if ($(this).valid()) {
                        // Tạo đối tượng FormData từ form
                        var formData = new FormData(this);


                        console.log('valid submitted');
                        for (var pair of formData.entries()) {
                            console.log(pair[0] + ': ' + pair[1]);
                        }
                        // Gửi dữ liệu bằng AJAX
                        NProgress.start()
                        $.ajax({
                            url: $(this).attr('action'), // URL gửi yêu cầu
                            type: 'POST', // Phương thức gửi dữ liệu
                            data: formData, // Dữ liệu gửi đi
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                NProgress.done()
                                console.log('response', response);
                                if (response?.success) {
                                    modal.hide()
                                    Table.ajax.reload()
                                    AddEvenBtn()
                                    toast.success(response?.message)
                                } else {
                                    toast.danger(response?.enumErrors?.map(str => `- ${str}`).join("\n"))
                                }
                            },
                            error: function (xhr, status, error) {
                                // Xử lý lỗi
                                toast.danger(error)
                                console.log('An error occurred: ' + error)
                                NProgress.done()
                            }
                        });
                    }


                });
            }
        })
    </script>
}





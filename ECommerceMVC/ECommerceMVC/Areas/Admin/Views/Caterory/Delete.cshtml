@model ECommerceMVC.Domain.Entities.DbCategory



<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="py-3 mb-4"><span class="text-muted fw-light">Category /</span> Delete</h4>

    <div class="card">
        <div class="alert alert-danger" role="alert">Do you want to delete the category<br />ID : @Model.Id <br /> Name : @Model.Name  </div>
        <div class="form-group">
            <form asp-action="Delete" asp-route-id="@Model.Id">
                <input type="submit" value="Delete" class="btn btn-danger" /> 
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </form>
        </div>
    </div>
</div>
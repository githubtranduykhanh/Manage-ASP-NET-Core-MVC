@section scriptsAdminPage {
    @{
        await Html.RenderPartialAsync("_DashboardPageScriptsPartial");
    }

    <script type="text/javascript">
        'use strict';

        $(document).ready(function () {
            (() => {

                // Lấy năm hiện tại
                var currentYear = new Date().getFullYear();

                $.ajax({
                    url: `@Url.Action("GetDataChart", "Home")?year=${currentYear}`, // URL gửi yêu cầu
                    type: 'GET', // Phương thức gửi dữ liệu                
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log(response)
                        if (response?.success){
                            updateRevenueChart(response?.data?.totalRevenue)

                            dashboardAdmin.growthChart.updateSeries([response?.data?.growthChart])



                            dashboardAdmin.profileReportChart.updateSeries([
                                {
                                        data: response?.data?.profileReportChart
                                }
                            ])



                            dashboardAdmin.statisticsChart.updateSeries(response?.data?.statisticsChart?.data)

                            dashboardAdmin.statisticsChart.updateOptions({
                                labels: response?.data?.statisticsChart?.labels
                            });

                            updateIncomeChart(response?.data?.totalBalance?.incomeChart)


                            dashboardAdmin.weeklyExpenses.updateSeries([response?.data?.totalBalance?.weeklyExpensesChart])
                        }
                    },
                    error: function (xhr, status, error) {
                        // Xử lý lỗi
                       
                        console.log('An error occurred: ' + error)               
                    }
                });


                const updateRevenueChart = (chartData) => {
                    console.log(chartData)                
                    // Lấy danh sách tất cả các tháng có dữ liệu
                    var allMonths = getMonths(chartData);

                    // Cắt các số và bổ sung dữ liệu thiếu cho các tháng trong biểu đồ
                    var newChartData = chartData.map(function (item) {
                        var filteredData = filterAndCutNumbers(item.data, allMonths);
                        return {
                            name: item.name,
                            data: filteredData
                        };
                    });

                    // Cập nhật dữ liệu biểu đồ
                    dashboardAdmin.totalRevenueChart.updateSeries(newChartData);
                    dashboardAdmin.totalRevenueChart.updateOptions({
                        xaxis: {
                            categories: allMonths
                        }
                    });
                }


                const updateIncomeChart = (chartData) => {
                    console.log(chartData)
                    // Lấy danh sách tất cả các tháng có dữ liệu
                    var allMonths = getMonthsIncomeChart(chartData);

                    var filteredData = filterAndCutNumbersIncomeChart(chartData, allMonths);


                    console.log({ allMonths, filteredData })

                    // Cập nhật dữ liệu biểu đồ
                    dashboardAdmin.incomeChart.updateSeries([
                        {
                            data: filteredData
                        }
                    ])

                    dashboardAdmin.incomeChart.updateOptions({
                        xaxis: {
                            categories: allMonths
                        }
                    });
                }

                // Hàm để lấy danh sách các tháng có dữ liệu từ các năm
                const getMonths = (data) => {
                    var categories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    var monthsSet = new Set();

                    data.forEach(yearData => {
                        yearData.data.forEach((value, index) => {
                            if (value > 0) {
                                monthsSet.add(categories[index]);
                            }
                        });
                    });

                    return Array.from(monthsSet);
                }

                // Hàm để lấy danh sách các tháng có dữ liệu từ các năm
                const getMonthsIncomeChart = (data) => {
                    var categories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                    var monthsSet = new Set();
                    data.forEach((value, index) => {
                        if (value > 0) {
                            monthsSet.add(categories[index]);
                        }
                    });
                 
                    return Array.from(monthsSet);
                }

                // Hàm để cắt số và bổ sung dữ liệu thiếu cho các tháng
                const filterAndCutNumbers = (data, categories) => {
                    var fullData = Array(categories.length).fill(0);
                    var originalCategories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

                    data.forEach((num, index) => {
                        if (num > 0) {
                            var monthIndex = categories.indexOf(originalCategories[index]);
                            if (monthIndex !== -1) {
                                fullData[monthIndex] = num / 1000;
                            }
                        }
                    });

                    return fullData;
                }


                // Hàm để cắt số và bổ sung dữ liệu thiếu cho các tháng
                const filterAndCutNumbersIncomeChart = (data, categories) => {
                    var fullData = Array(categories.length).fill(0);
                    var originalCategories = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

                    data.forEach((num, index) => {
                        if (num > 0) {
                            var monthIndex = categories.indexOf(originalCategories[index]);
                            if (monthIndex !== -1) {
                                fullData[monthIndex] = num * 10;
                            }
                        }
                    });

                    return fullData;
                }


               


              

              

               

               

            })()
        })     
    </script>

{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "ckeditor5@42.0.1",
      "destination": "wwwroot/lib/ckeditor5/",
      "files": [
        "ckeditor.min.js"
      ]
    },
    {
      "provider": "unpkg",
      "library": "jquery-ui@1.13.3",
      "destination": "wwwroot/jquery-ui/",
      "files": [
        "dist/jquery-ui.min.js",
        "dist/themes/base/jquery-ui.min.css"
      ]
    }
  ]
}